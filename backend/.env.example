# Copy to backend/.env and fill in values

MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=yourapp
MONGO_DB_NAME=yourdb
JWT_SECRET=change_me_to_a_long_random_string
PORT=5001
FRONTEND_URL=http://localhost:8080

# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords
# Use the 16-character password (no spaces) as SMTP_PASS — NOT your Gmail login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_FROM="JoyEvents" <your-account@gmail.com>
